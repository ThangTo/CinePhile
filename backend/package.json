{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "tiktok:worker": "python ./tiktok_worker/app.py",
    "tiktok:once": "python ./tiktok_worker/app.py --once-json",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop cinephine-api",
    "pm2:stop:worker": "pm2 stop cinephine-tiktok-worker",
    "pm2:restart": "pm2 restart cinephine-api",
    "pm2:restart:worker": "pm2 restart cinephine-tiktok-worker",
    "pm2:reload": "pm2 reload cinephine-api",
    "pm2:delete": "pm2 delete cinephine-api",
    "pm2:logs": "pm2 logs cinephine-api",
    "pm2:logs:worker": "pm2 logs cinephine-tiktok-worker",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:chatbot": "node scripts/testChatbotBackend.js",
    "test:chatbot:win": "powershell -ExecutionPolicy Bypass -File scripts/testChatbotBackend.ps1",
    "test:watch-streak": "node scripts/testWatchStreakLogic.js",
    "test:playback-heartbeat": "node scripts/testPlaybackHeartbeatService.js"
  },
