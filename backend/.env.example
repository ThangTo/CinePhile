# CinePhine backend environment example
# Copy to .env and replace placeholders. Do not commit real secrets.

# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5001
CLIENT_URL_LOCAL=http://localhost:5001
API_BASE_URL=http://localhost:5000
DNS_RESULT_ORDER=ipv4first
SOURCE_TLS_MIN_VERSION=TLSv1.2
UPSTREAM_FETCH_TIMEOUT_MS=15000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cinephine
MONGO_URI=
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=10
MONGODB_RETRY_DELAY_MS=10000

# Auth, cookies, OAuth
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
ACCESS_TOKEN_MAX_AGE_MS=3600000
REFRESH_TOKEN_MAX_AGE_MS=604800000
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_BASE_URL=http://localhost:5000
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5001/auth/google/callback?status=success
GOOGLE_FAILURE_REDIRECT=http://localhost:5001/auth/google/callback?status=failure

# API limits and logging
RATE_LIMIT_MAX=600
RATE_LIMIT_MAX_AUTH=10
CACHE_LOGS=false
ANALYTICS_LOCAL_MAX_IDENTIFIERS=5000
ANALYTICS_LOCAL_VISIT_RETENTION_DAYS=2

# Redis
# REDIS_URL must be a TCP Redis URL for Bull workers.
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_REST_TIMEOUT_MS=10000
REDIS_REST_COOLDOWN_MS=30000
REDIS_REST_ERROR_LOG_INTERVAL_MS=15000

# PM2 and process bulkheads
WEB_CONCURRENCY=1
PM2_INSTANCES=
API_MAX_MEMORY_RESTART=450M
API_NODE_ARGS=--max-old-space-size=384
API_CRON_ENABLED=false
SCHEDULER_PM2_ENABLED=true
SCHEDULER_MAX_MEMORY_RESTART=400M
QUEUE_WORKERS_PM2_ENABLED=true
WORKER_NODE_ARGS=--max-old-space-size=512
ANALYSIS_WORKER_INSTANCES=1
ANALYSIS_WORKER_MAX_MEMORY_RESTART=700M
RENDER_WORKER_INSTANCES=1
RENDER_WORKER_MAX_MEMORY_RESTART=900M
INTRO_WORKER_INSTANCES=1
INTRO_WORKER_MAX_MEMORY_RESTART=700M
SUBTITLE_WORKER_INSTANCES=1
SUBTITLE_WORKER_MAX_MEMORY_RESTART=700M

# Streaming, HLS, and download proxy
MOBILE_DOWNLOAD_MAX_CONCURRENT=1
MAX_CONCURRENT_DOWNLOADS=
DOWNLOAD_M3U8_TIMEOUT_MS=30000
TS_PROXY_TIMEOUT_MS=30000
PROXY_TS_MAX_ACTIVE_SESSIONS=3
PROXY_TS_MAX_USERS=
PROXY_TS_SESSION_TTL_MS=90000

# Queue timeouts and concurrency
VIDEO_QUEUE_CONCURRENCY=1
VIDEO_QUEUE_TIMEOUT_MS=300000
ANALYSIS_QUEUE_TIMEOUT_MS=1800000
ANALYSIS_QUEUE_LOCK_DURATION_MS=1800000
ANALYSIS_QUEUE_STALLED_INTERVAL_MS=60000
ANALYSIS_QUEUE_MAX_STALLED_COUNT=2
SUBTITLE_QUEUE_TIMEOUT_MS=3600000
INTRO_DETECTION_REQUIRE_REDIS=true
INTRO_DETECTION_CONCURRENCY=1
INTRO_DETECTION_QUEUE_TIMEOUT_MS=1800000
INTRO_DETECTION_ADD_TIMEOUT_MS=2500
INTRO_DETECTION_FFMPEG_TIMEOUT_MS=300000

# Cron and scheduler
CRON_ENABLED=true
CRON_EPISODE_UPDATES_ENABLED=true
CRON_MOVIE_CRAWLING_ENABLED=true
CRON_TRENDING_UPDATE_ENABLED=true
CRON_ANALYTICS_SNAPSHOT_ENABLED=true
CRON_ANALYTICS_BACKFILL_ENABLED=true
CRON_QUEST_AUTO_CLAIM_ENABLED=true
CRON_MONGO_BACKUP_ENABLED=true
CRON_INTRO_BATCH_ENABLED=true
INTRO_BATCH_ENABLED=true
INTRO_BATCH_CRON=0 4 * * *
INTRO_BATCH_TIMEZONE=Asia/Ho_Chi_Minh
INTRO_BATCH_MAX_MOVIES=30
INTRO_BATCH_MAX_EPISODES_PER_MOVIE=120
INTRO_BATCH_INCLUDE_HIDDEN=false
INTRO_BATCH_RETRY_NO_MATCH=false
INTRO_BATCH_LOCK_TTL_SEC=21600
INTRO_BATCH_JOB_TIMEOUT_MS=2400000
INTRO_BATCH_JOB_POLL_MS=5000
INTRO_BATCH_BETWEEN_JOBS_MS=15000
INTRO_BATCH_MAX_RUNTIME_MS=18000000
INTRO_BATCH_SAMPLE_SIZE=5
INTRO_BATCH_SAMPLE_SECONDS=600
INTRO_BATCH_APPLY_SEASON_DEFAULT=true

# MongoDB backups to Cloudflare R2
# Requires MongoDB Database Tools on the server so mongodump is available.
MONGO_BACKUP_CRON=0 6 * * *
MONGO_BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
MONGO_BACKUP_URI=
MONGO_BACKUP_MONGODUMP_BIN=mongodump
MONGO_BACKUP_R2_BUCKET=
MONGO_BACKUP_R2_PREFIX=mongodb/daily
MONGO_BACKUP_NAME_PREFIX=cinephine-mongodb
MONGO_BACKUP_DIR=
MONGO_BACKUP_RETENTION_DAYS=30
MONGO_BACKUP_TIMEOUT_MS=3600000
MONGO_BACKUP_KEEP_LOCAL=false
MONGO_BACKUP_KEEP_FAILED_LOCAL=true

# Temporary files
CINEPHINE_TEMP_DIR=
TEMP_OUTPUT_DIR=

# Whisper and subtitle generation
WHISPER_API_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=auto
WHISPER_FORCE_LOCAL=false
WHISPER_CONCURRENCY=4
WHISPER_CHUNK_DURATION_SEC=600
WHISPER_CHUNK_ATTEMPTS=2
WHISPER_CHUNK_RETRY_DELAY_MS=5000
WHISPER_LOCAL_TIMEOUT_MS=1800000
WHISPER_REMOTE_TIMEOUT_MS=1800000
SUBTITLE_TRANSCRIPTION_LANGUAGE=auto
VIRAL_CLIP_WHISPER_CHUNK_DURATION_SEC=300
VIRAL_CLIP_TRANSCRIPTION_LANGUAGE=auto

# LLM providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.0-flash-001
LLM_FALLBACK_MODELS=
LLM_BASE_URL=
LLM_ENDPOINT_PATH=/chat/completions
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_HTTP_REFERER=http://localhost:5001
LLM_APP_TITLE=CinePhine Platform
LLM_HEADERS_JSON={}
VIRAL_OPENROUTER_API_KEY=
VIRAL_OPENAI_API_KEY=
VIRAL_LLM_PROVIDER=
VIRAL_LLM_MODEL=
VIRAL_LLM_FALLBACK_MODELS=
VIRAL_LLM_BASE_URL=
VIRAL_LLM_ENDPOINT_PATH=/chat/completions
VIRAL_LLM_API_KEY=
VIRAL_LLM_TIMEOUT_MS=60000
VIRAL_LLM_HTTP_REFERER=http://localhost:5001
VIRAL_LLM_APP_TITLE=CinePhine Viral Clip Generator
VIRAL_LLM_HEADERS_JSON={}
CHATBOT_SYSTEM_PROMPT=
GEMINI_API_KEY=

# Viral clip rendering
VIRAL_RENDER_CRF=20
VIRAL_RENDER_PRESET=medium
VIRAL_MOVIE_AUDIO_VOLUME=1.35
VIRAL_ORIGINAL_AUDIO_VOLUME=
VIRAL_BGM_VOLUME=0.18
VIRAL_SUBTITLE_ENABLED=true
VIRAL_SUBTITLE_FONT=Arial
VIRAL_SUBTITLE_FONT_SIZE=24
VIRAL_SUBTITLE_COLOR=FFFFFF
VIRAL_SUBTITLE_OUTLINE=2.4
VIRAL_SUBTITLE_SHADOW=0.7
VIRAL_SUBTITLE_MARGIN_V=44

# External APIs
TMDB_API_KEY=
TMDB_TIMEOUT_MS=15000
TMDB_LOGO_FETCH_CONCURRENCY=3
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
BREVO_API_KEY=
EMAIL_SENDER=no-reply@cinephine.com
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cloudflare R2 and public asset URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
PUBLIC_DOMAIN=http://localhost:5000
R2_SUBTITLE_FOLDER=subtitles
R2_AVATAR_FOLDER=avatars
R2_AVATAR_BASE_URL=
AVATAR_MAX_BYTES=5242880

# TikTok trending and worker
TIKTOK_ENABLED=true
TIKTOK_WORKER_PM2_ENABLED=false
TIKTOK_WORKER_MAX_MEMORY_RESTART=256M
PYTHON_BIN=python3
TIKTOK_WORKER_HOST=127.0.0.1
TIKTOK_WORKER_PORT=8787
TIKTOK_WORKER_URL=http://127.0.0.1:8787
TIKTOK_WORKER_CMD=
TIKTOK_MS_TOKEN=
TIKTOK_PROXY_URL=
TIKTOK_TRENDING_COUNT=30
TIKTOK_BROWSER=chromium
TIKTOK_IGNORE_HTTPS_ERRORS=true
TIKTOK_NAVIGATION_TIMEOUT_MS=60000
TIKTOK_OPERATION_TIMEOUT_MS=60000
TIKTOK_FETCH_TIMEOUT_MS=45000
TIKTOK_FETCH_RETRIES=2
TIKTOK_TMDB_SEARCH_LIMIT=10
TIKTOK_DOWNLOAD_MAX_CONCURRENT=1
TRENDING_AUTO_CRAWL_LIMIT=6
