# CinePhine frontend environment example
# Copy to .env and replace values for your environment.

REACT_APP_API_URL=http://localhost:5000/api/v1
REACT_APP_API_TIMEOUT=10000
REACT_APP_USE_SERVER_ADBLOCK=true

REACT_APP_AVATAR_BASE_URL=http://localhost:5000/api/v1/avatars
REACT_APP_PUBLIC_DOMAIN=

REACT_APP_MODEL_URL=https://teachablemachine.withgoogle.com/models/EdvGvkVEl/
REACT_APP_WAKE_WORD_THRESHOLD=0.85
REACT_APP_WAKE_WORD_LABEL="Class 2"
REACT_APP_COMMAND_TIMEOUT=7000
REACT_APP_WAKE_COOLDOWN=5000
REACT_APP_MAX_SPEECH_FAILURES=3
REACT_APP_LS_KEY_ENABLED=timi_enabled
